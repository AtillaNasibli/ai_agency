# --- Google Sheet ledger ---
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
SHEET_ID=your_google_sheet_id
SHEET_TAB=Ledger

# --- Daily e-mail brief (Gmail app password, NOT your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
MAIL_TO=you@gmail.com

# --- Where the 8 employee folders live ---
EMPLOYEES_DIR=./employees

# --- Local LLM (Ollama) used by bridge/ollama_agent.py ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
CLIENT_NAME=Acme Coffee Roasters
CLIENT_BRIEF=Small specialty coffee roaster selling whole-bean subscriptions online to home brewers in Europe.

# --- Model routing (bridge/llm.py): local first, cloud only as fallback ---
LLM_ROUTE=ollama,openrouter
# OpenRouter (https://openrouter.ai) - optional cloud fallback / cloud council members
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# --- LLM Council for the Chief of Staff (Karpathy-style, bridge/council.py) ---
# Leave empty = use up to 3 different models installed in Ollama (needs >= 2).
# Example: COUNCIL_MODELS=ollama:llama3.1,ollama:llama3.2,openrouter:google/gemini-2.0-flash-001
COUNCIL_MODELS=
COUNCIL_CHAIRMAN=
